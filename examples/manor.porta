# manor.porta — a small manor house, ground floor.
# Feet on a 5-ft grid; up = north. Names are illustrative.

room entrance "Entrance Hall" 20x20 root
room hall     "Great Hall"    40x30 up-of entrance
room library  "Library"       30x30 left-of hall
room dining   "Dining Room"   30x30 right-of hall
room parlour  "Parlour"       20x20 left-of entrance
room cloak    "Cloakroom"     20x20 right-of entrance no-door
room kitchen  "Kitchen"       30x25 down-of dining
room pantry   "Pantry"        15x25 right-of kitchen
room study    "Study"         20x20 down-of parlour
room scullery "Scullery"      30x20 down-of kitchen
room porch    "Porch"         10x10 down-of entrance shift=5
room larder   "Larder"        15x15 right-of pantry  shift=5
room gallery  "Gallery"       20x10 up-of hall      align=end
room turret   "Turret"        15x15 left-of library align=end shift=-5

# The cloakroom opens off the great hall, not the entrance (see no-door above).
door cloak hall
